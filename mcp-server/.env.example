# All settings are optional - the server works with none of them set.

# "remote" (default) reads live from GitHub; "bundled" disables all network reads
# and serves the snapshot compiled into the build.
SLACKPLAN_DATA_MODE=remote

# Branch to read feature data from.
SLACKPLAN_BRANCH=main

# How long fetched data stays warm before re-checking GitHub, in milliseconds.
SLACKPLAN_CACHE_TTL_MS=600000

# Timeout for any single upstream request, in milliseconds.
SLACKPLAN_FETCH_TIMEOUT_MS=15000

# Raises the GitHub API rate limit for "last updated" lookups.
# Unauthenticated is 60 requests/hour per IP, which is usually plenty.
# A public, read-only, no-scope token is sufficient.
# GITHUB_TOKEN=

# --- HTTP transport only --------------------------------------------------

# Port to listen on. Heroku sets this automatically.
PORT=3000

# Path the MCP endpoint is served from.
SLACKPLAN_MCP_PATH=/mcp

# Shared secret. If set, clients must send "Authorization: Bearer <token>".
# Strongly recommended for any internet-reachable deployment.
# SLACKPLAN_AUTH_TOKEN=

# Comma-separated allowed Origin header values (browser clients only).
# SLACKPLAN_ALLOWED_ORIGINS=https://example.slack.com
