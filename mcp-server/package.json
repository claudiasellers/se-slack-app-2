{
  "name": "slack-plan-comparison-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the Slack Plan Comparison Tool - compare Slack plans, feature availability, and line-of-business pain points",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "slack-plan-comparison-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node test/parity.test.mjs",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "snapshot": "node scripts/build-snapshot.mjs",
    "prepare": "npm run build",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
